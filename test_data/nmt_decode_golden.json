[{"src": "hin_Deva", "tgt": "sat_Olck", "text": "पानी कहाँ से आता है", "ids": [2, 88706, 48377, 88077, 66336, 90364, 73125, 31428, 2], "decoded_raw": "ᱫᱟᱜ ᱫᱚ ᱪᱮᱫ ᱠᱷᱚᱱ ᱦᱮᱡ ᱟᱠᱟᱱᱟ ᱾", "expected": "ᱫᱟᱜ ᱫᱚ ᱪᱮᱫ ᱠᱷᱚᱱ ᱦᱮᱡ ᱟᱠᱟᱱᱟ ᱾"}, {"src": "hin_Deva", "tgt": "sat_Olck", "text": "शुभ प्रभात", "ids": [2, 93706, 21919, 31428, 2], "decoded_raw": "ᱱᱟᱯᱟᱭ صبح ᱾", "expected": "ᱱᱟᱯᱟᱭ صبح ᱾"}, {"src": "hin_Deva", "tgt": "sat_Olck", "text": "अपनी किताब खोलो", "ids": [2, 79072, 103129, 48377, 93030, 67823, 31428, 2], "decoded_raw": "ᱟᱢᱟᱜ ᱯᱚᱛᱚᱵ ᱫᱚ ᱮᱦᱚᱵ ᱢᱮ ᱾", "expected": "ᱟᱢᱟᱜ ᱯᱚᱛᱚᱵ ᱫᱚ ᱮᱦᱚᱵ ᱢᱮ ᱾"}, {"src": "hin_Deva", "tgt": "sat_Olck", "text": "आज का विषय पौधे हैं। क्या कोई प्रश्न है?", "ids": [2, 98109, 48806, 96359, 48377, 79018, 63364, 94170, 96242, 31428, 88077, 93181, 88925, 92413, 70574, 74933, 11, 2], "decoded_raw": "ᱛᱮᱦᱮᱧ ᱨᱮᱭᱟᱜ ᱥᱟᱛᱟᱢ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ ᱚᱛᱢᱚᱱ ᱾ ᱪᱮᱫ ᱡᱟᱦᱟᱱ ᱯᱚᱨᱤᱢᱟᱱ ᱢᱮᱱᱟᱜᱼᱟ ?", "expected": "ᱛᱮᱦᱮᱧ ᱨᱮᱭᱟᱜ ᱥᱟᱛᱟᱢ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ ᱚᱛᱢᱚᱱ ᱾ ᱪᱮᱫ ᱡᱟᱦᱟᱱ ᱯᱚᱨᱤᱢᱟᱱ ᱢᱮᱱᱟᱜᱼᱟ?"}, {"src": "hin_Deva", "tgt": "sat_Olck", "text": "2 और 3 को जोड़ो — उत्तर क्या है?", "ids": [2, 174, 44857, 267, 85363, 67823, 69570, 91261, 88077, 11, 2], "decoded_raw": "2 ᱟᱨ 3 ᱥᱮᱞᱮᱫ ᱢᱮᱼ ᱩᱛᱛᱚᱨ ᱪᱮᱫ ?", "expected": "2 ᱟᱨ 3 ᱥᱮᱞᱮᱫ ᱢᱮᱼ ᱩᱛᱛᱚᱨ ᱪᱮᱫ?"}, {"src": "hin_Deva", "tgt": "sat_Olck", "text": "तुम्हारा नाम क्या है?", "ids": [2, 79072, 81465, 88077, 11, 2], "decoded_raw": "ᱟᱢᱟᱜ ᱧᱩᱛᱩᱢ ᱪᱮᱫ ?", "expected": "ᱟᱢᱟᱜ ᱧᱩᱛᱩᱢ ᱪᱮᱫ?"}, {"src": "hin_Deva", "tgt": "sat_Olck", "text": "कोई सवाल? हाथ उठाओ।", "ids": [2, 93181, 88925, 92413, 70574, 11, 91907, 82054, 41991, 86927, 67823, 31428, 2], "decoded_raw": "ᱡᱟᱦᱟᱱ ᱯᱚᱨᱤᱢᱟᱱ ? ᱛᱤ ᱪᱮᱛᱟᱱ ᱨᱮ ᱫᱚᱦᱚ ᱢᱮ ᱾", "expected": "ᱡᱟᱦᱟᱱ ᱯᱚᱨᱤᱢᱟᱱ? ᱛᱤ ᱪᱮᱛᱟᱱ ᱨᱮ ᱫᱚᱦᱚ ᱢᱮ ᱾"}, {"src": "hin_Deva", "tgt": "sat_Olck", "text": "बहुत बढ़िया! शाबाश।", "ids": [2, 78645, 93706, 40, 87194, 102596, 31428, 2], "decoded_raw": "ᱟᱹᱰᱤ ᱱᱟᱯᱟᱭ ! ᱥᱟᱵᱟᱥ ᱾", "expected": "ᱟᱹᱰᱤ ᱱᱟᱯᱟᱭ! ᱥᱟᱵᱟᱥ ᱾"}, {"src": "sat_Olck", "tgt": "hin_Deva", "text": "ᱛᱮᱦᱮᱧ", "ids": [2, 755, 2], "decoded_raw": "आज", "expected": "आज"}, {"src": "sat_Olck", "t